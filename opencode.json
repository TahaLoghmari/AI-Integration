{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/AGENTS.md"],
  "lsp": true,
  "permission": {
    "lsp": "allow",
    "question": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git stash *": "ask",
      "git reset *": "ask",
      "git rebase *": "ask",
      "git checkout *": "ask",
      "git merge *": "ask",
      "git clean *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "docker *": "ask",
      "curl *": "ask",
      "wget *": "ask"
    },
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    }
  }
}
